{% extends 'web/base.html.twig' %}
{% block title %}Login{% endblock %}

{% block body %}
    <div class="container mt-5" style="max-width:420px">
        <h1 class="h3 mb-3">Login</h1>

        {% if error %}
            <div class="alert alert-danger">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {{ form_start(form, { attr: { class: 'vstack gap-2' } }) }}
        {{ form_row(form._username, { attr: { autofocus: true, placeholder: 'Email', class: 'form-control' } }) }}
        {{ form_row(form._password, { attr: { placeholder: 'Password', class: 'form-control' } }) }}
        {{ form_row(form._remember_me) }}
        <button class="btn btn-primary w-100">Sign in</button>
        {{ form_end(form) }}

        <div class="mt-3"><a href="{{ path('app_register') }}">Create an account</a></div>
    </div>
{% endblock %}
