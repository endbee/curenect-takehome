{% extends 'web/base.html.twig' %}
{% block title %}Register{% endblock %}

{% block body %}
    <div class="container mt-5" style="max-width:420px">
        <h1 class="h3 mb-3">Register</h1>

        {% for m in app.flashes('error') %}
            <div class="alert alert-danger">{{ m }}</div>
        {% endfor %}
        {% for m in app.flashes('success') %}
            <div class="alert alert-success">{{ m }}</div>
        {% endfor %}

        {{ form_start(form, { attr: { class: 'vstack gap-2' } }) }}
        {{ form_row(form.email, { attr: { placeholder: 'Email', class: 'form-control' } }) }}
        {{ form_row(form.plainPassword, { attr: { placeholder: 'Password', class: 'form-control' } }) }}
        <button class="btn btn-primary w-100">Create account</button>
        {{ form_end(form) }}

        <div class="mt-3"><a href="{{ path('app_login') }}">Back to login</a></div>
    </div>
{% endblock %}
