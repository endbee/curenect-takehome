{% extends 'base.html.twig' %}

{% block title %}Todo List{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="card-title text-primary mb-4">📋 My Todo List</h1>

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success mb-3">{{ message }}</div>
                {% endfor %}

                {% if todos is not empty %}
                    <ul class="list-group mb-4">
                        {% for t in todos %}
                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                <div>
                                    {{ t.task }} {% if t.done %}<span class="badge bg-success">Done</span>{% endif %}
                                    {% if t.dueAt %}
                                        {% set nowTs = 'now'|date('U') %}
                                        {% set dueTs = t.dueAt|date('U') %}
                                        {% set diffMin = (dueTs - nowTs) / 60 %}
                                        {% set badgeClass = t.done
                                            ? 'bg-secondary'
                                            : (dueTs < nowTs ? 'bg-danger'
                                            : (diffMin <= 1440 ? 'bg-warning text-dark'
                                            : 'bg-info')) %}

                                        <span class="badge rounded-pill {{ badgeClass }} ms-2" title="{{ t.dueAt|date('d.m.Y H:i') }}">
                                        {% if t.done %}
                                            ⏳ due {{ t.dueAt|date('d.m. H:i') }}
                                        {% else %}
                                            {% if dueTs < nowTs %}
                                                🔴 overdue {{ t.dueAt|date('d.m. H:i') }}
                                            {% elseif diffMin <= 60 %}
                                                ⏰ in {{ (diffMin)|round(0, 'ceil') }} min
                                            {% elseif diffMin <= 1440 and t.dueAt|date('Y-m-d') == 'now'|date('Y-m-d') %}
                                                ⏰ today {{ t.dueAt|date('H:i') }}
                                            {% elseif (t.dueAt|date_modify('-1 day'))|date('Y-m-d') == 'now'|date('Y-m-d') %}
                                                🟡 tomorrow {{ t.dueAt|date('H:i') }}
                                            {% else %}
                                                📅 {{ t.dueAt|date('d.m.') }} {{ t.dueAt|date('H:i') }}
                                            {% endif %}
                                        {% endif %}
                                      </span>
                                    {% else %}
                                        <span class="badge rounded-pill bg-light text-muted ms-2">— no due date —</span>
                                    {% endif %}
                                </div>
                                <div class="btn-group">
                                    {% if is_granted('EDIT', t) %}
                                        <form method="post" action="{{ path('todo_toggle', {id: t.id}) }}">
                                            <button class="btn btn-sm btn-outline-secondary">{{ t.done ? 'Undo' : 'Complete' }}</button>
                                        </form>
                                    {% endif %}
                                    {% if is_granted('DELETE', t) %}
                                        <form method="post" action="{{ path('todo_delete', {id: t.id}) }}" onsubmit="return confirm('Delete this todo?')">
                                            <button class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="text-muted">No todos yet.</p>
                {% endif %}

                {% form_theme form 'bootstrap_5_layout.html.twig' %}
                <h2 class="h5 mb-3">Add a new todo</h2>
                {{ form_start(form, { attr: { class: 'row g-2' } }) }}
                <div class="col-9">
                    {{ form_row(form.task, { label: false, attr: { class: 'form-control', placeholder: 'Enter your task' } }) }}
                    {{ form_row(form.dueAt) }}
                </div>
                <div class="col-9">
                    <button class="btn btn-primary w-100">Add</button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
